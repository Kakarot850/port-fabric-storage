{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "license": "${mod_license}",
  "icon": "${mod_logo_file}",
  "authors": ["${mod_authors_elements}"],
  "contact": {
    "homepage": "${mod_display_url}",
    "issues": "${mod_issue_tracker_url}",
    "sources": "${mod_sources_url}"
  },
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.p3pp3rf1y.sophisticatedstorage.SophisticatedStorage"
    ],
    "client": [
      "net.p3pp3rf1y.sophisticatedstorage.client.SophisticatedStorageClient"
    ]
  },
  "mixins": [
    "sophisticatedstorage.mixins.json"
  ],
  "accessWidener": "sophisticatedstorage.accesswidener",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version_range}",
    "java": ">=25",
    "fabric-api": ">=${fabric_api_version}",
    "forgeconfigapiport": ">=${forge_config_api_port_version}",
    "sophisticatedcore": ">=${sc_mod_version}"
  },
  "suggests": {
    "modmenu": "*"
  },
  "custom": {
    "modmenu": {
      "badges": [
      ],
      "parent": {
        "id": "sophisticatedmods",
        "name": "Sophisticated Mods",
        "description": "Group of P3pp3rF1y's Sophisticated Mods"
      }
    },
    "loom:injected_interfaces": {
      "net/minecraft/server/level/ServerLevel": [
        "net/p3pp3rf1y/sophisticatedstorage/extensions/level/SophisticatedStorageServerLevel"
      ],
      "net/minecraft/world/level/block/entity/BlockEntity": [
        "net/p3pp3rf1y/sophisticatedstorage/extensions/block/entity/SophisticatedStorageBlockEntity"
      ]
    }
  }
}
